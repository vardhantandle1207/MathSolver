# Copy this to .env and fill in your key.  (cp .env.example .env)

# Which backend to use: "groq" (free hosted) or "ollama" (local).
LLM_PROVIDER=groq

# --- Groq (free tier: https://console.groq.com) ---
GROQ_API_KEY=your_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# --- Ollama (local, no key needed) ---
# Install from https://ollama.com, then: ollama pull qwen2.5:7b-instruct
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_HOST=http://localhost:11434

# --- Agent behaviour ---
MAX_STEPS=8
TEMPERATURE=0.0
EXEC_TIMEOUT=10

# --- Safety / reliability rails ---
MAX_RETRIES=3            # retry transient LLM failures (with backoff)
MAX_REPEATS=3            # loop detection: refuse identical tool call after N tries
MAX_TOKENS_BUDGET=20000  # hard stop once cumulative tokens exceed this (0 = off)
MAX_PROBLEM_CHARS=4000   # reject oversized problem input up front
